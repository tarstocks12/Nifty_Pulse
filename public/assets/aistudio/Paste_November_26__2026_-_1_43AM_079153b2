htf_w_range_bg = math.max(htf_w_max_bg - htf_w_min_bg, 0.0001)
htf_s_ratio_bg = (htf_w_range_bg / htf_t_range_bg) * tsiAmp

project_bg(val, _esa, _d) => _esa + (val * 0.015 * _d)

