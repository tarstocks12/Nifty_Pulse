wt_calc_bg(chanLen, avgLen, sType) =>
    ap_bg = hlc3
    esa_bg = ta.ema(ap_bg, chanLen)
    d_bg = ta.ema(math.abs(ap_bg - esa_bg), chanLen)
    ci_bg = (ap_bg - esa_bg) / (0.015 * d_bg)
    wt1_bg = sType == "ALMA" ? ta.alma(ci_bg, avgLen, 0.85, 6) : ta.ema(ci_bg, avgLen)
    [wt1_bg, esa_bg, d_bg]

f_wt_combined_bg(chanLen, avgLen, sType) =>
